{
  "type": "object",
  "title": "NetSuite Connection",
  "required": [
    "account_id",
    "consumer_key",
    "#consumer_secret",
    "token_id",
    "#token_secret"
  ],
  "properties": {
    "account_id": {
      "type": "string",
      "title": "Account ID",
      "description": "NetSuite account ID. For a sandbox, add the sandbox suffix (e.g. 1234567_SB1).",
      "propertyOrder": 1,
      "options": {
        "inputAttributes": {
          "placeholder": "1234567 or 1234567_SB1"
        }
      }
    },
    "consumer_key": {
      "type": "string",
      "title": "Consumer Key",
      "description": "TBA integration consumer key.",
      "propertyOrder": 2
    },
    "#consumer_secret": {
      "type": "string",
      "title": "Consumer Secret",
      "description": "TBA integration consumer secret.",
      "format": "password",
      "propertyOrder": 3
    },
    "token_id": {
      "type": "string",
      "title": "Token ID",
      "description": "TBA access token id.",
      "propertyOrder": 4
    },
    "#token_secret": {
      "type": "string",
      "title": "Token Secret",
      "description": "TBA access token secret.",
      "format": "password",
      "propertyOrder": 5
    },
    "test_connection": {
      "type": "button",
      "format": "sync-action",
      "propertyOrder": 6,
      "options": {
        "async": {
          "label": "Test Connection",
          "action": "testConnection"
        }
      }
    }
  }
}
