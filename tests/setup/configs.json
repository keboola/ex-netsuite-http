  {
    "name": "17_suiteql_incremental",
    "description": "suiteql incremental load with a date range: the :date_from/:date_to placeholders are substituted from the parsed date range, and the output table is upserted on 'id'.",
    "config": {
      "action": "run",
      "parameters": {
        "account_id": "1234567_SB1",
        "#consumer_key": "DUMMY_CK",
        "#consumer_secret": "DUMMY_CS",
        "#token_id": "DUMMY_TI",
        "#token_secret": "DUMMY_TS",
        "mode": "suiteql",
        "query": "SELECT id, companyname, lastmodifieddate FROM customer WHERE lastmodifieddate BETWEEN :date_from AND :date_to AND id BETWEEN 2206 AND 2251",
        "date_from": "2000-01-01",
        "date_to": "now",
        "load_type": "incremental_load",
        "output_table_name": "suiteql_incremental",
        "primary_key": ["id"]
      }
    }
